# ===========================================================================
# YAAR — environment configuration
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# `.env` is git-ignored. NEVER commit real keys.
# ===========================================================================

# ---------------------------------------------------------------------------
# Core server
# ---------------------------------------------------------------------------
NODE_ENV=development
# Port for the single Yaar server (serves both the API and the web client)
PORT=8787
# Bind address. Keep 0.0.0.0 so containers / phones on your LAN / preview
# environments can reach it.
HOST=0.0.0.0
# Set to 1 when running behind a reverse proxy (nginx, Fly, Render, Railway…)
TRUST_PROXY=0
# CSP frame-ancestors. '*' (default) allows preview panes and WebView shells.
# Use 'self' on a public deployment, or list exact origins to allow.
FRAME_ANCESTORS=*

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# huggingface        -> Hugging Face Inference Providers router (default)
# openai-compatible  -> any OpenAI-compatible /chat/completions endpoint
AI_PROVIDER=huggingface

# ---------------------------------------------------------------------------
# Hugging Face (https://huggingface.co/settings/tokens)
# Create a token with the "Make calls to Inference Providers" permission.
# ---------------------------------------------------------------------------
# REQUIRED for live AI replies. The value stays on the server only.
HF_API_KEY=hf_your_token_here
# Inference Providers router (OpenAI-compatible). Do not add /chat/completions.
HF_BASE_URL=https://router.huggingface.co/v1
# Primary model. Qwen3-8B is a good multilingual (English/Urdu/Hindi) default.
HF_MODEL=Qwen/Qwen3-8B
# Optional comma-separated fallbacks, tried in order if the primary model is
# unavailable for your token/provider routing.
HF_MODEL_FALLBACKS=meta-llama/Llama-3.1-8B-Instruct,openai/gpt-oss-20b
# Optional provider pin, e.g. "together", "cerebras", "hf-inference", "fastest".
HF_INFERENCE_PROVIDER=
HF_TEMPERATURE=0.85
HF_TOP_P=0.95
HF_MAX_TOKENS=400
# Max time for one full AI reply (ms)
HF_TIMEOUT_MS=45000
# Max time between two streamed chunks before we give up (ms)
HF_IDLE_TIMEOUT_MS=20000
# Stream tokens to the client (recommended, feels like real texting)
AI_STREAMING=true

# ---------------------------------------------------------------------------
# Optional: any OpenAI-compatible provider (Ollama, LM Studio, vLLM, Groq…)
# Only used when AI_PROVIDER=openai-compatible
# ---------------------------------------------------------------------------
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=qwen2.5:7b-instruct

# ---------------------------------------------------------------------------
# Database (SQLite file, created automatically)
# ---------------------------------------------------------------------------
DATABASE_PATH=./data/yaar.sqlite
DATABASE_BUSY_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Daily usage limit (rolling 24 hour window, enforced server-side)
# ---------------------------------------------------------------------------
DAILY_MESSAGE_LIMIT=20
USAGE_WINDOW_HOURS=24
# If the AI fails before producing any text, give the message back (refund).
REFUND_FAILED_MESSAGES=true

# ---------------------------------------------------------------------------
# Anonymous sessions
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_COOKIE_NAME=yaar_sid
SESSION_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_MAX_AGE_DAYS=365
# Sent automatically by the client; lets the app keep the same anonymous
# identity even when cookies are unavailable (e.g. Capacitor/Android WebView).
DEVICE_ID_HEADER=x-yaar-device-id

# ---------------------------------------------------------------------------
# Abuse protection
# ---------------------------------------------------------------------------
CHAT_RATE_LIMIT_PER_MINUTE=30
SESSION_RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Client (build-time, must be prefixed with VITE_)
# ---------------------------------------------------------------------------
VITE_APP_VERSION=1.0.0
