# ===========================================================================
# YAAR — environment configuration
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# `.env` is git-ignored. NEVER commit real keys.
# ===========================================================================

# ---------------------------------------------------------------------------
# Core server
# ---------------------------------------------------------------------------
NODE_ENV=development
# Port for the single Yaar server (serves both the API and the web client)
PORT=8787
# Bind address. Keep 0.0.0.0 so containers / phones on your LAN / preview
# environments can reach it.
HOST=0.0.0.0
# Set to 1 when running behind a reverse proxy (nginx, Fly, Render, Railway…).
# Empty = off, except on Vercel where it is on automatically.
TRUST_PROXY=
# CSP frame-ancestors. '*' (default) allows preview panes and WebView shells.
# Use 'self' on a public deployment, or list exact origins to allow.
FRAME_ANCESTORS=*

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# huggingface        -> Hugging Face Inference Providers router (default)
# bazaarlink         -> BazaarLink (OpenAI-compatible, https://api.bazaarlink.ai/v1)
# openai-compatible  -> any OpenAI-compatible /chat/completions endpoint
AI_PROVIDER=huggingface

# ---------------------------------------------------------------------------
# BazaarLink — only used when AI_PROVIDER=bazaarlink
# OpenAI-compatible API: the server POSTs to {BAZAARLINK_BASE_URL}/chat/completions
# with "Authorization: Bearer <BAZAARLINK_API_KEY>".
# ---------------------------------------------------------------------------
# REQUIRED for bazaarlink. Server-only secret — never give it a VITE_ prefix.
BAZAARLINK_API_KEY=
# Optional (these are the defaults). Do not add /chat/completions.
BAZAARLINK_BASE_URL=https://api.bazaarlink.ai/v1
BAZAARLINK_MODEL=deepseek-v4-flash
# Optional comma-separated models tried if the primary one fails.
BAZAARLINK_MODEL_FALLBACKS=
# Sampling / timeouts below (HF_TEMPERATURE, HF_MAX_TOKENS, HF_TIMEOUT_MS, …)
# apply to EVERY provider, including BazaarLink, despite the HF_ prefix.

# ---------------------------------------------------------------------------
# Hugging Face (https://huggingface.co/settings/tokens)
# Create a token with the "Make calls to Inference Providers" permission, then
# put it in YOUR OWN `.env` (git-ignored) — never in this file, which is
# committed to the repository.
#
#   cp .env.example .env      # then paste the token into .env
#   npm run check:secrets     # verifies no token was ever committed
#
# REQUIRED for live AI replies. Read only by the server (server/config.js);
# it is never bundled into, or reachable from, the frontend JavaScript.
# ---------------------------------------------------------------------------
HUGGINGFACE_API_KEY=
# Legacy alias, still accepted if you already have it set:
# HF_API_KEY=
# Inference Providers router (OpenAI-compatible). Do not add /chat/completions.
HF_BASE_URL=https://router.huggingface.co/v1
# Primary model. Qwen3-8B is a good multilingual (English/Urdu/Hindi) default.
HF_MODEL=Qwen/Qwen3-8B
# Optional comma-separated fallbacks, tried in order if the primary model is
# unavailable for your token/provider routing.
HF_MODEL_FALLBACKS=meta-llama/Llama-3.1-8B-Instruct,openai/gpt-oss-20b
# Optional provider pin, e.g. "together", "cerebras", "hf-inference", "fastest".
HF_INFERENCE_PROVIDER=
HF_TEMPERATURE=0.85
HF_TOP_P=0.95
HF_MAX_TOKENS=400
# Max time for one full AI reply (ms)
HF_TIMEOUT_MS=45000
# Max time between two streamed chunks before we give up (ms)
HF_IDLE_TIMEOUT_MS=20000
# Stream tokens to the client (recommended, feels like real texting)
AI_STREAMING=true

# ---------------------------------------------------------------------------
# Optional: any OpenAI-compatible provider (Ollama, LM Studio, vLLM, Groq…)
# Only used when AI_PROVIDER=openai-compatible
# ---------------------------------------------------------------------------
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=qwen2.5:7b-instruct

# ---------------------------------------------------------------------------
# Database — PostgreSQL
#
# Production (Vercel): set DATABASE_URL to your Supabase Postgres connection
# string. Supabase dashboard → Connect → "Transaction pooler" (port 6543) is
# the right choice for serverless. Tables are created automatically on first
# request (or paste server/db/schema.sql into the Supabase SQL editor).
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Server-only secret (it contains the database password).
#
# Local development: leave DATABASE_URL empty and an embedded Postgres (PGlite)
# is stored in DATABASE_PATH — no install needed. `npm run db:reset` wipes it.
# ---------------------------------------------------------------------------
DATABASE_URL=
# TLS for DATABASE_URL. Auto: on for remote hosts, off for localhost.
DATABASE_SSL=
# Connections per server instance (default 10; 1 on Vercel).
DATABASE_POOL_MAX=
# Local PGlite data directory (ignored when DATABASE_URL is set).
DATABASE_PATH=./data/pglite

# ---------------------------------------------------------------------------
# Supabase Auth (email + password)
# Supabase dashboard → Project Settings → API Keys / Data API.
# Leave SUPABASE_URL empty to run without accounts (anonymous only).
# ---------------------------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# PUBLIC key: the new "publishable" key (sb_publishable_…) or the legacy
# "anon" key. Safe to expose. Either name works:
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
# SERVER-ONLY SECRET: the "secret" key (sb_secret_…) or legacy "service_role"
# key. Used ONLY to delete the Supabase account on Settings → Delete. Optional —
# without it, deletion removes Yaar's data but leaves the login in place.
# NEVER prefix it with VITE_.
SUPABASE_SECRET_KEY=
# Optional, legacy projects only: the JWT secret (Settings → JWT Keys → Legacy
# JWT secret). Lets the server verify old HS256 tokens without a network call.
# Projects on the new asymmetric signing keys verify via JWKS and don't need it.
SUPABASE_JWT_SECRET=

# Login policy (enforced by the server, which only trusts a verified JWT):
#   AUTH_REQUIRED=false + ALLOW_ANONYMOUS=true  -> accounts optional (default)
#   AUTH_REQUIRED=true  (or ALLOW_ANONYMOUS=false) -> every chat/history/usage
#                                                  request needs a login
AUTH_REQUIRED=false
ALLOW_ANONYMOUS=true

# ---------------------------------------------------------------------------
# Daily usage limit (rolling 24 hour window, enforced server-side)
# ---------------------------------------------------------------------------
DAILY_MESSAGE_LIMIT=20
USAGE_WINDOW_HOURS=24
# If the AI fails before producing any text, give the message back (refund).
REFUND_FAILED_MESSAGES=true

# ---------------------------------------------------------------------------
# Anonymous sessions (REQUIRED in production, including Vercel)
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_COOKIE_NAME=yaar_sid
SESSION_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_MAX_AGE_DAYS=365
# Sent automatically by the client; lets the app keep the same anonymous
# identity even when cookies are unavailable (e.g. Capacitor/Android WebView).
DEVICE_ID_HEADER=x-yaar-device-id

# ---------------------------------------------------------------------------
# Abuse protection
# ---------------------------------------------------------------------------
CHAT_RATE_LIMIT_PER_MINUTE=30
SESSION_RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Client (build-time, must be prefixed with VITE_)
# Everything VITE_* is inlined into the public JavaScript bundle — PUBLIC
# values only. On Vercel, set these BEFORE building (they're read at build time).
# ---------------------------------------------------------------------------
VITE_APP_VERSION=1.0.0
# Same values as SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY above. Leave empty to
# hide the sign-in UI. (VITE_SUPABASE_ANON_KEY is accepted as an alias.)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
